# Airflow
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-to-a-random-string

# Supabase (ingestion)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET=

# Supabase (transform / OpenLineage)
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=
OPENLINEAGE_NAMESPACE=nhl

# AWS (required for ingestion .env and scripts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
